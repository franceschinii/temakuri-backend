generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  email        String?   @unique
  passwordHash String?
  isGuest      Boolean   @default(false)
  isBot        Boolean   @default(false)
  isAdmin      Boolean   @default(false)
  isBanned     Boolean   @default(false)
  isPremium    Boolean   @default(false)
  suspendedUntil DateTime?
  avatarIndex  Int       @default(0)
  xp           Int       @default(0)
  level        Int       @default(1)
  coins        Int       @default(0)
  diamonds     Int       @default(0)
  pds          Int       @default(0)
  winStreak    Int       @default(0)
  lossStreak   Int       @default(0)
  rankedWarnings         Int       @default(0)
  rankedSuspendedUntil   DateTime?
  premiumExpiresAt       DateTime?
  lastPremiumGrantAt     DateTime?
  externalCustomerId     String?   @unique
  activeTheme            String?
  /// Para bots: 'easy' | 'medium' | 'hard'. Para humanos: null.
  /// Controla a IA do bot (heuristica e velocidade de jogada).
  botDifficulty          String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  stats             UserStats?
  inventory         UserInventory?
  rankedStats       RankedStats?
  sessions          Session[]
  roomPlayers       RoomPlayer[]
  gameResults       GameResult[]
  passwordResetTokens PasswordResetToken[]
  diamondTransactions  DiamondTransaction[]
  premiumSubscriptions PremiumSubscription[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserStats {
  id            String @id @default(cuid())
  userId        String @unique
  gamesPlayed   Int    @default(0)
  gamesWon      Int    @default(0)
  saborTriggers Int    @default(0)
  tricksWon     Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Room {
  id         String     @id @default(cuid())
  code       String     @unique
  hostId     String
  status     String     @default("WAITING")
  mode       String     @default("TRADITIONAL")
  maxPlayers Int        @default(4)
  isPrivate      Boolean    @default(true)
  isRanked       Boolean    @default(false)
  handBias       Float      @default(0)
  initialTokens  Int        @default(2)
  password       String?
  createdAt      DateTime   @default(now())
  startedAt  DateTime?
  endedAt    DateTime?

  players     RoomPlayer[]
  gameResults GameResult[]
}

model RoomPlayer {
  id          String   @id @default(cuid())
  roomId      String
  userId      String
  seat        Int
  status      String   @default("CONNECTED")
  sessionWins Int      @default(0)
  joinedAt    DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@unique([roomId, seat])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GameResult {
  id          String   @id @default(cuid())
  roomId      String
  userId      String
  placement   Int
  tokensLeft  Int
  xpEarned    Int      @default(0)
  coinsEarned Int      @default(0)
  pdsChange   Int      @default(0)
  isRanked    Boolean  @default(false)
  createdAt   DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id])
  user User @relation(fields: [userId], references: [id])
}

model UserInventory {
  id              String   @id @default(cuid())
  userId          String   @unique
  unlockedAvatars Int[]    @default([0, 1, 2, 3])
  unlockedModes   String[] @default(["TRADITIONAL"])
  unlockedThemes  String[] @default([])

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DiamondTransaction {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            String   // 'PURCHASE' | 'SPEND' | 'PREMIUM_GRANT' | 'REFUND' | 'ADMIN_GRANT'
  amount          Int      // positivo ou negativo
  description     String?
  externalPaymentId   String? @unique
  externalInvoiceId   String? @unique
  sku             String?
  metadata        Json?
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
}

model PremiumSubscription {
  id                   String    @id @default(uuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status               String    // 'ACTIVE' | 'PAST_DUE' | 'CANCELLED' | 'EXPIRED'
  startedAt            DateTime  @default(now())
  expiresAt            DateTime
  cancelAtPeriodEnd    Boolean   @default(false)
  externalSubscriptionId String  @unique
  externalCustomerId     String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userId, status])
  @@index([expiresAt])
}

model RankedStats {
  id           String @id @default(cuid())
  userId       String @unique
  rankedWins   Int    @default(0)
  rankedLosses Int    @default(0)
  peakPds      Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Cupom de desconto criado por admin. Aplica em compras de diamantes
/// (e Premium, quando appliesTo permitir). discountPercent vai de 1 a 100.
model Coupon {
  id              String   @id @default(cuid())
  code            String   @unique
  discountPercent Int
  /// "all" = aplicavel a tudo; "diamonds" = so pacotes de diamante;
  /// "premium" = so assinatura premium. Default: "all".
  appliesTo       String   @default("all")
  validFrom       DateTime @default(now())
  validUntil      DateTime
  maxUses         Int?
  currentUses     Int      @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  redemptions CouponRedemption[]

  @@index([code, active])
  @@index([validUntil])
}

/// Override de preco de item de catalogo, editavel pelo admin.
/// Se nao existir override pra um (kind,key), o codigo usa o default
/// hardcoded. kind: 'avatar_coins' | 'avatar_diamonds' | 'mode' |
/// 'theme' | 'coin_pack' | 'utility' | 'diamond_pack' | 'premium'.
/// price em centavos pra BRL (diamond_pack/premium) ou unidade direta
/// (coins/diamonds) — interpretado pelo ShopPricingService.
model CatalogPrice {
  id        String   @id @default(cuid())
  kind      String
  key       String
  price     Float
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([kind, key])
  @@index([kind])
}

/// Entrada do changelog gerenciada pelo admin. Substitui o array
/// hardcoded antigo em src/data/changelog.ts do frontend.
model ChangelogEntry {
  id         String   @id @default(cuid())
  date       String
  version    String
  title      String
  category   String
  highlights String[]
  details    String
  published  Boolean  @default(true)
  sortIndex  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([published, sortIndex])
}

/// Log de uso de cupom — 1 registro por aplicacao em compra.
model CouponRedemption {
  id            String   @id @default(cuid())
  couponId      String
  userId        String
  paymentSku    String?
  discountValue Float
  createdAt     DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([couponId])
}
