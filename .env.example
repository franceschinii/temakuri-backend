DATABASE_URL="file:./dev.db"
JWT_SECRET="temakuri-dev-secret-change-in-prod"
JWT_REFRESH_SECRET="temakuri-refresh-secret-change-in-prod"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
FRONTEND_URL="http://localhost:5173"
PORT=3001
NODE_ENV="development"

# URLs do app (Fase B em prod)
APP_BASE_URL="http://localhost:5173"
APP_API_URL="http://localhost:3001"

# Pagamentos (Mercado Pago) — Fase A roda com flag off; Fase B preenche tudo
PAYMENTS_ENABLED=false
# Access token de producao (APP_USR-...) ou teste (TEST-...)
MP_ACCESS_TOKEN=""
# Signing secret do webhook (configurado no painel MP)
MP_WEBHOOK_SECRET=""
# ID do Preapproval Plan do Premium mensal (R$ 7,90)
# Se vazio, o backend cria preapproval avulso com auto_recurring inline.
MP_PREAPPROVAL_PLAN_ID_PREMIUM=""
# Em sandbox usar sandbox_init_point do MP; em prod usar init_point
MP_USE_SANDBOX=false
