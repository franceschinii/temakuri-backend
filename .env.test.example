# Copie para .env.test e ajuste DATABASE_URL conforme seu setup.
# - Rodando testes dentro do container (docker compose exec backend ...): use "@postgres:5432"
# - Rodando testes no host com Postgres local ou via port-forward do Docker: use "@localhost:5432"
DATABASE_URL="postgresql://temakuri:CHANGE_ME@postgres:5432/temakuri_test?schema=public"
JWT_SECRET="test-access-secret"
JWT_REFRESH_SECRET="test-refresh-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
FRONTEND_URL="http://localhost:5173"
PORT=3002
NODE_ENV="test"
